<!-- ganti mode pada -->
<script>
    let modeIni = "tambah";


    const tombolMode = document.querySelector(".mode .pilih .tombol");
    const tombolModePilihan = document.querySelectorAll(".mode .pilih .pilihan");
    const displayModeName = document.querySelector(".mode .terpilih");

    let tertutup = true
    tombolMode.addEventListener("click", function(){
        if(tertutup){
            document.querySelector(".mode .pilih").style.overflowY = "unset";
            tertutup = !tertutup;
        } else {
            document.querySelector(".mode .pilih").style.overflowY = "hidden";
            tertutup = !tertutup;
        }
    });
    tombolModePilihan.forEach((ini, i) => {
        ini.addEventListener("click", function(){
            if(tertutup){
                document.querySelector(".mode .pilih").style.overflowY = "unset";
                tertutup = !tertutup;
            } else {
                document.querySelector(".mode .pilih").style.overflowY = "hidden";
                tertutup = !tertutup;
            }
            if(i == "0"){
                displayModeName.textContent = "tambah data";
                modeIni = "tambah";
                tampilkanFont(idPath, modeIni);
                displayModeName.style.backgroundColor = "#82f166";
                displayModeName.style.color = "black"
            } else if(i == "1"){
                displayModeName.textContent = "hapus data";
                modeIni = "hapus";
                tampilkanFont(idPath, modeIni);
                displayModeName.style.backgroundColor = "red";
                displayModeName.style.color = "white"
            } else {
                displayModeName.textContent = "edit data";
                modeIni = "edit";
                tampilkanFont(idPath, modeIni);
                displayModeName.style.backgroundColor = "blue";
                displayModeName.style.color = "white"
            }
        })
    })

</script>

<!-- meload data svg dan menampilkan di atas page -->
<script>
    const tampilkan = document.querySelector(".hurufan");

    const inputan = document.querySelector("textarea");
    const dariMana = document.getElementById("ambilDari");

    inputan.addEventListener("keyup", function(){
        
        const paths = dariMana.querySelector('path');
        
        paths.setAttribute("d", this.value)
    })

    const idPath = window.location.href.split("/").pop();
    tampilkanFont(idPath, modeIni);
    
    async function tampilkanFont(idPath, modeIni = "tambah") {
        console.log(modeIni);

        let paths = []
        try {
            const response = await fetch(`/api/ambil-dengan/${idPath}`);
            if(!response.ok){
                throw new Error("not ok");
            }
            
            paths = await response.json();
        } catch(err){
            console.log(err);
        } finally {
            if(paths.kumpulan != null){
                const onol = paths.kumpulan.map(ono => {
                    let lebar = 192
                    let tinggi = 192
                    if(ono.ukuran){
                        tinggi = parseInt(ono.ukuran[0]);
                        lebar = parseInt(ono.ukuran[1]);
                    }
                    const lebar2 = 8 * lebar/192;
    
                    let catatan = "..."
                    if(ono.catatan){
                        catatan = ono.catatan == null ? "..." : ono.catatan;
                    } 
    
                    return `
                    <div class="ini">
                        <div class="copyy">
                            <svg id="petunjuk" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg">
                                
                                <path d="M 0 96 H 32 V 0 H 64 V 64 H 112 L 176 160 V 192 H 0"
                                fill="black" />
                                
                            </svg>
                        </div>
                        <svg class="sesuatuIni" id="${ono.id}" viewBox="0 0 ${lebar} ${tinggi}" xmlns="http://www.w3.org/2000/svg">
                            
                            <path d="${ono.path}"
                            ukuran="${tinggi+","+lebar}"
                            namanya="${ono.catatan}"
                            fill="black" />
                            
                        </svg>
                        <div class="nama">
                            <small>
                                ${catatan}
                            </small>
                        </div>
                    </div>
                    `
                }).join("");
                // tampilkan.insertAdjacentHTML("forened", ono);
                tampilkan.innerHTML = onol;
            }
        }
    }
</script>


<!-- untuk mengatur ukuran  -->
<script>
    const tombolTampilkanInput = document.querySelector("form .ukuran .petunjuk");
    const inputanLebar = document.querySelectorAll("form .ukuran input");

    const garisanPetunjuk = document.querySelectorAll(".garisanPetunjuk");

    let belum = true;
    tombolTampilkanInput.addEventListener("click", function(){
        if(belum){
            document.querySelector("form .ukuran").style.height = "max-content";
            belum = !belum;
        } else {
            document.querySelector("form .ukuran").style.height = "1rem";
            belum = !belum;
        }
    })

    inputanLebar.forEach((ini, i) => {
        ini.addEventListener("input", function(){
            gantiUkuranSvg(ini.value, i)
        })
    });
    function gantiUkuranSvg(angka, ke){
        const bulatan = Math.round(angka/32 * 2 - 6);

        if(ke == 0){
            garisanPetunjuk[ke].style.transform = `translateX(calc(-50% + 3/2 * ${bulatan}rem))`
        } else {
            garisanPetunjuk[ke].style.transform = `translateY(calc(-50% + 3/2 * ${bulatan}rem))`
        }
    }


</script>

<!-- melakukan submit/post data -->
<script>

    const myForm = document.querySelector('form');
    const submitBtn = document.querySelector('#submit');
    
    const catatan = document.querySelector("form #catatan");
    
    async function handleFormSubmit (event) {
        const valueLebar = [inputanLebar[0].value, inputanLebar[1].value];

        event.preventDefault();
        const jsonIni = {
            ukuran: valueLebar,
            catatan:catatan.value,
            path: inputan.value
        }
        console.log(JSON.stringify(jsonIni))
        try {
            if(modeIni == "edit" && idSvgTerpilihUntukDiEdit){
                // set id yang akan di edit
                jsonIni.id = idSvgTerpilihUntukDiEdit;

                const response = await fetch(`/api/edit-path/${idPath}/${idSvgTerpilihUntukDiEdit}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(jsonIni) 
                });
                if(!response.ok){
                    throw new Error("no okk");
                }
    
                const feedBack = await response.json();
                console.log(feedBack);
            } else {
                const response = await fetch('/api/tambahkan-path/'+ idPath, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(jsonIni) 
                });
                if(!response.ok){
                    throw new Error("no okk");
                }
    
                const feedBack = await response.json();
                console.log(feedBack);
            }
        } catch(err) {
            console.log(err);
        } finally {
            tampilkanFont(idPath, modeIni);
        }
    }

    submitBtn.addEventListener("click", handleFormSubmit);
</script>


<!-- untuk menampilkan image ke layer belakang -->
 <script>
    const inputFile = document.querySelector(".image input.foto");
    const tampilkanGambar = document.getElementById("previewGambar");
    const parentHilang = tampilkanGambar.parentElement;
    const tombolTampilkan = document.querySelector(".tombolanFoto .lihat");

    inputFile.addEventListener('change', function() {
            
        // 4. Ambil file yang dipilih (files[0])
        const file = this.files[0];

        if (file) {
            // 5. Buat objek FileReader
            const reader = new FileReader();

            // 6. Tentukan apa yang terjadi saat file selesai dibaca
            reader.onload = function(e) {
                // e.target.result berisi Data URL (string Base64)
                // Atur 'src' dari <img> ke hasil bacaan
                tampilkanGambar.src = e.target.result;
            }

            // 7. Baca file sebagai Data URL (memicu event 'onload')
            reader.readAsDataURL(file);
            if(parentHilang.classList.contains("terlihat")){
            } else {
                parentHilang.classList.toggle("terlihat");
            }
        }
    });
        
    tombolTampilkan.addEventListener("click", function(){
        parentHilang.classList.toggle("terlihat");
    })

 </script>

<!-- untuk tombolan geser -->
 <script>
    const tombolHori = document.querySelectorAll(".hori .tombol");
    const tombolVerti = document.querySelectorAll(".verti .tombol");

    // geser ke kanan dan kiri
    tombolHori.forEach((tomble, i) => {
        tomble.addEventListener("click", function(){
            if(i == 0){
                geserHori(16);
            } else {
                geserHori(-16);
            }
        })
    });
    // geser ke kanan dan kiri
    tombolVerti.forEach((tomble, i) => {
        tomble.addEventListener("click", function(){
            if(i == 0){
                geserVerti(16);
            } else {
                geserVerti(-16);
            }
        })
    });


    function geserHori(valueIni){
        const sebelumDari = inputan.value.split(" ");
        const dari = sebelumDari.map(ini => {
            return ini.replace(",", "").replace("\n", "")
        });

        let indexNotNan = null;

        const geser = valueIni;

        // balik vertical
        const hasilan = dari.map((ini, i) => {
            try {
                const angka = parseInt(ini);

                if(Number.isFinite(angka)){
                    if(dari[indexNotNan] == "A"){
                        if(indexNotNan + 6 == i) {
                            return angka + geser;
                        } else if (indexNotNan + 6 == i) {
                            return angka + geser;
                        } else {
                            return angka;
                        }
                    } else if(dari[parseInt(i)-1] == "V"){
                        return angka;
                    } else {
                        if(indexNotNan + 2 == i) {
                            return angka;
                        } else if(indexNotNan + 1 == i) {
                            return angka + geser;
                        }
                    }
                } else {
                    indexNotNan = i;
                    return ini;
                }
            } catch(err){
                console.log(err);
            }
        }).join(" ");
        inputan.value = hasilan;
        const paths = dariMana.querySelector('path');
        
        paths.setAttribute("d", hasilan)
    }

    function geserVerti(valueIni){
        const sebelumDari = inputan.value.split(" ");
        const dari = sebelumDari.map(ini => {
            return ini.replace(",", "").replace("\n", "")
        });
        
        let indexNotNan = null

        const geser = valueIni;

        // balik vertical
        const hasilan = dari.map((ini, i) => {
            try {
                const angka = parseInt(ini);

                if(Number.isFinite(angka)){
                    if(dari[indexNotNan] == "A"){
                        if(indexNotNan + 7 == i) {
                            return angka + geser;
                        } else {
                            return angka;
                        }
                    } else if(dari[parseInt(i)-1] == "H"){
                            return angka;
                    } else {
                        if(indexNotNan + 2 == i) {
                            return angka + geser;
                        } else if(indexNotNan + 1 == i) {
                            if(dari[parseInt(i)-1] == "V"){
                                return angka + geser;
                            } else {
                                return angka;
                            }
                        }
                    }
                } else {
                    indexNotNan = i;
                    return ini;
                }
            } catch(err){
                console.log(err);
            }
        }).join(" ");

        inputan.value = hasilan;
        const paths = dariMana.querySelector('path');
        
        paths.setAttribute("d", hasilan)
    }


 </script>

