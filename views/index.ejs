<style>
    .daftarFonts {
        display: flex;
        flex-direction: column;
    }
    .tambahkan {
        width: 320px;
        height: max-content;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: var(--cur-pointer);
        background-color: #000;
        padding: .5rem;
        svg {
            height: 2rem;
            fill: #fff;
        }
    }
    .tambahkan:hover {
        background-color: #fff;
        svg {
            fill: #000;
        }
    }
</style>

<div class="kata">
    <h1>Nama font :</h1>
    <div class="daftarFonts"></div>
    <a href="/tambah" class="tambahkan">
        <svg id="23" viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg">
            <path d="M 64 0 H 96 V 64 H 160 V 96 H 96 V 160 H 64 V 96 H 0 V 64 H 64 Z"></path>
        </svg>
    </a>
</div>

<script>
    let font = []
    const daftarFonts = document.querySelector(".daftarFonts");

    tampilkanNama();
    async function tampilkanNama() {
        try {
            const response = await fetch("/api/judul-table");
            if(!response.ok){
                throw new Error("not ok");
            }
    
            font = await response.json();
            console.log(font)
    
        } catch(err){
            console.log(err);
        } finally {
            const sup = font.map(ini => {
                return `
                <a href="/font/dari/${ini.id}">
                    <h1>${ini.judul}
                    </h1>
                </a>
                `
            }).join(" ");
            daftarFonts.innerHTML = sup;
        }
    }
</script>